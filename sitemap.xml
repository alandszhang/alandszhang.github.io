---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for path in site.pages %}{% if path.layout == 'homepage' %}<url><loc>{{ path.url | absolute_url | xml_escape }}</loc></url>{% endif %}{% endfor %}
  {% for paper in site.publications %}<url><loc>{{ paper.url | absolute_url | xml_escape }}</loc></url>{% endfor %}
  {% for talk in site.talks %}<url><loc>{{ talk.url | absolute_url | xml_escape }}</loc></url>{% endfor %}
</urlset>
